{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 300
      }
    },
    {
      "src": "tradecouncil---institutional-multi-agent-quantitative-terminal/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "tradecouncil---institutional-multi-agent-quantitative-terminal/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/docs",
      "dest": "/api/index.py"
    },
    {
      "src": "/openapi.json",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*\\.(js|css|ico|png|svg|woff|woff2|ttf|map))",
      "dest": "/tradecouncil---institutional-multi-agent-quantitative-terminal/dist/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/tradecouncil---institutional-multi-agent-quantitative-terminal/dist/index.html"
    }
  ]
}
